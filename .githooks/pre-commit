#!/bin/sh
# VisionX pre-commit: frena lo peligroso antes de que llegue a la historia.
# Funciona en macOS, Linux y Windows (Git for Windows corre los hooks con su sh).

branch=$(git branch --show-current)

# 1. No commitear directo en main (salvo el primer commit del repo o con VISIONX_ALLOW_MAIN=1).
if [ "$branch" = "main" ] && git rev-parse --verify HEAD >/dev/null 2>&1 && [ "$VISIONX_ALLOW_MAIN" != "1" ]; then
  echo "No se commitea directo en main. Crea una rama: git switch -c <a|b>/<id>-<tema>"
  exit 1
fi

# 2. Nada de archivos grandes (> 1 MB) ni pesos/datos/secretos, aunque se fuercen con -f.
bad=$(git diff --cached --name-only --diff-filter=AM | while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in
    (.env.example|tests/fixtures/*) ;;
    (*.pt|*.pth|*.ckpt|*.onnx|*.safetensors|*.npy|*.npz|*.pkl|*.mp4|*.avi|.env|.env.*)
      echo "  $f (tipo prohibido)"; continue ;;
  esac
  case "$f" in (*.pdf) continue ;; esac
  size=$(wc -c <"$f" | tr -d ' ')
  [ "$size" -gt 1048576 ] && echo "  $f ($((size / 1024)) KB)"
done)
if [ -n "$bad" ]; then
  echo "Archivos que no van a git:"
  echo "$bad"
  echo "Sacalos con: git restore --staged <archivo>"
  exit 1
fi

# 3. Posibles claves de API.
if git diff --cached -U0 | grep -E '^\+' | grep -qE '(sk-ant-[A-Za-z0-9_-]{20,}|sk-(proj-)?[A-Za-z0-9_-]{32,}|AKIA[0-9A-Z]{16})'; then
  echo "Parece haber una clave de API en el commit. Va en .env, que no se sube."
  exit 1
fi

# 4. Lint y formato sobre los .py del commit.
if git diff --cached --name-only --diff-filter=AM -- '*.py' | grep -q .; then
  uv run --quiet ruff format --check . || { echo "Formato: corre 'uv run ruff format .'"; exit 1; }
  uv run --quiet ruff check . || exit 1
fi
exit 0
