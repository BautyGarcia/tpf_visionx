#!/bin/sh
# Corre los tests antes de subir, y frena el push directo a main.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$VISIONX_ALLOW_MAIN" != "1" ]; then
    echo "No se pushea directo a main. Abrí un pull request."
    exit 1
  fi
done
uv run --quiet pytest -q || { echo "Los tests fallan. No se sube."; exit 1; }
